
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101318"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SILLENG AI TRADING"
            android:textColor="#D9B45B"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="XAUUSD GOLD • AI SIGNALS ONLY"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp" />

        <WebView
            android:id="@+id/chartWebView"
            android:layout_width="match_parent"
            android:layout_height="360dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GEMINI API KEY"
            android:textColor="#D9B45B"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your Gemini API key"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:hintTextColor="#999999"
            android:backgroundTint="#D9B45B" />

        <Button
            android:id="@+id/saveKeyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE API KEY" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MARKET INFORMATION"
            android:textColor="#D9B45B"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <EditText
            android:id="@+id/marketInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:hint="Enter XAUUSD price, timeframe, trend, support, resistance and market observations..."
            android:inputType="textMultiLine"
            android:textColor="#FFFFFF"
            android:hintTextColor="#999999"
            android:backgroundTint="#D9B45B"
            android:padding="10dp" />

        <Button
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANALYZE WITH GEMINI AI" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI SIGNAL RESULT"
            android:textColor="#D9B45B"
            android:textStyle="bold"
            android:paddingTop="18dp" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for market analysis..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="#202630" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WARNING: AI signals are not financial advice. Verify every signal and manage your risk."
            android:textColor="#FFB74D"
            android:textSize="12sp"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
